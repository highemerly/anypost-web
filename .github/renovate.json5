{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // docker:pinDigests: node:24-alpine・nginx:alpine を digest で固定する。タグのままだと Alpine・Node・nginx の
  // 更新がリリース時のビルドで無言で入る。固定すると digest の更新が PR になり、E2E を通してから取り込める。
  extends: ['config:recommended', 'docker:pinDigests'],
  timezone: 'Asia/Tokyo',
  // 週2回にまとめる（毎日 PR が来ると確認が追いつかず、週1だと間隔が空きすぎる）。
  schedule: ['before 9am on monday and thursday'],
  // 時間あたりの上限（既定は1時間に2件）は外す。数は schedule で既に絞っており、App は枠の中で
  // 数回しか動かないため、1回の枠で作られる PR が少なく、溜まった更新が次の枠へ持ち越される。
  // 同時に開く数の上限（prConcurrentLimit・既定10）は、CI が壊れたときに PR が溜まり続けないよう残す。
  prHourlyLimit: 0,
  // GitHub Release のノートで Dependencies の見出しに分ける（.github/release.yml）。
  labels: ['dependencies'],
  // PR を github.com/pulls の「Assigned to you」にまとめる（いくつものリポジトリから来るので見落とさない）。
  assignees: ['highemerly'],
  // 間接依存（lockfile だけにある版）も週1で更新する。
  lockFileMaintenance: {
    enabled: true,
  },
  // メジャーはコード側の対応が要ることが多いので、着手するときに Dependency Dashboard で承認して PR を作らせる
  // （自動で並ぶと、対応できないまま毎週 rebase される PR が溜まる）。
  major: {
    dependencyDashboardApproval: true,
  },
  packageRules: [
    {
      // package.json の範囲（^x.y.z）の下限も上げる。範囲内の更新でも PR になり、
      // package.json を見れば実際に入っている版が分かる状態を保つ。
      // npm に限る（Docker の node:24-alpine や .nvmrc の 24 まで 24.x.y に固定されるため）。
      matchManagers: ['npm'],
      rangeStrategy: 'bump',
    },
    {
      // 乗っ取られて公開された版は数日以内に取り下げられることが多いため、公開から3日待つ。
      // npm に限る（Docker の digest には公開日時が無く、待てないため）。
      matchDatasources: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      // Node のメジャーは Dockerfile（node:24-alpine）・.nvmrc（CI もここを読む）・E2E の偽 API を
      // 揃えて上げる必要があるため1つの PR にまとめる。
      matchDepNames: ['node', 'nodejs'],
      matchUpdateTypes: ['major'],
      groupName: 'Node.js major',
    },
    {
      // eslint と @eslint/js（eslint:recommended の中身）は同じメジャーで出るので一緒に上げる。
      matchPackageNames: ['eslint', '@eslint/js'],
      groupName: 'eslint',
    },
    {
      // eslint-plugin-vue は vue-eslint-parser を peer に取り、片方だけ上げると npm が解決できないことがある。
      matchPackageNames: ['eslint-plugin-vue', 'vue-eslint-parser'],
      groupName: 'eslint-plugin-vue',
    },
    {
      // マイナー・パッチ・digest は CI（ci-result＝lint・ビルド・E2E）が緑なら自動でマージする。
      // E2E は本番と同じイメージ（nginx）で主要なページの描画と、共有リンクから axios で偽 API を引いて共有先へ移るところまで通す。
      // digest（node・nginx）も、Dockerfile の変更で E2E がイメージをビルドして走るので自動にする。
      // メジャー（承認制）・lockfile の一括更新は手でマージする（lockfile は間接依存がまとめて動き、除外している依存も含みうるため）。
      // マージしても main に入るだけで、本番へはリリース（タグ）とデプロイ PR のマージを経る。
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      // CI が緑でも確かめていないもの。1つの PR に1つでも automerge: false の更新があれば自動ではマージされない。
      // - 画面の土台と操作（E2E はクリック・入力をしない）: vue・vue-router・pinia・vue-i18n・@headlessui/vue
      // - 見た目（E2E は見た目を比べない）: tailwindcss・@tailwindcss/vite・@heroicons/vue・@fontsource-variable/inter
      // - マイナーでも互換を崩しうる 0.x: neostandard（0.x の依存を足したら、ここにも足す）
      matchPackageNames: [
        'vue',
        'vue-router',
        'pinia',
        'vue-i18n',
        '@headlessui/vue',
        'tailwindcss',
        '@tailwindcss/**',
        '@heroicons/vue',
        '@fontsource-variable/inter',
        'neostandard',
      ],
      automerge: false,
    },
    {
      // タグ時にしか動かないワークフローは、ブランチの CI（ci-targets.sh）で何も回さず
      // ci-result がスキップのまま緑になる＝何も確かめずにマージされてしまう。
      matchFileNames: ['.github/workflows/docker-build.yml', '.github/workflows/tag-release.yml'],
      automerge: false,
    },
  ],
}
