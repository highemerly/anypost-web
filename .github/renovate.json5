{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // docker:pinDigests: node:24-alpine・nginx:alpine を digest で固定する。タグのままだと Alpine・Node・nginx の
  // 更新がリリース時のビルドで無言で入る。固定すると digest の更新が PR になり、E2E を通してから取り込める。
  extends: ['config:recommended', 'docker:pinDigests'],
  timezone: 'Asia/Tokyo',
  // 週2回にまとめる（毎日 PR が来ると確認が追いつかず、週1だと間隔が空きすぎる）。
  schedule: ['before 9am on monday and thursday'],
  // GitHub Release のノートで Dependencies の見出しに分ける（.github/release.yml）。
  labels: ['dependencies'],
  // PR を github.com/pulls の「Assigned to you」にまとめる（いくつものリポジトリから来るので見落とさない）。
  assignees: ['highemerly'],
  // 間接依存（lockfile だけにある版）も週1で更新する。
  lockFileMaintenance: {
    enabled: true,
  },
  // メジャーはコード側の対応が要ることが多いので、着手するときに Dependency Dashboard で承認して PR を作らせる
  // （自動で並ぶと、対応できないまま毎週 rebase される PR が溜まる）。
  major: {
    dependencyDashboardApproval: true,
  },
  packageRules: [
    {
      // package.json の範囲（^x.y.z）の下限も上げる。範囲内の更新でも PR になり、
      // package.json を見れば実際に入っている版が分かる状態を保つ。
      // npm に限る（Docker の node:24-alpine や .nvmrc の 24 まで 24.x.y に固定されるため）。
      matchManagers: ['npm'],
      rangeStrategy: 'bump',
    },
    {
      // 乗っ取られて公開された版は数日以内に取り下げられることが多いため、公開から3日待つ。
      // npm に限る（Docker の digest には公開日時が無く、待てないため）。
      matchDatasources: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      // Node のメジャーは Dockerfile（node:24-alpine）・.nvmrc（CI もここを読む）・E2E の偽 API を
      // 揃えて上げる必要があるため1つの PR にまとめる。
      matchDepNames: ['node', 'nodejs'],
      matchUpdateTypes: ['major'],
      groupName: 'Node.js major',
    },
    {
      // eslint と @eslint/js（eslint:recommended の中身）は同じメジャーで出るので一緒に上げる。
      matchPackageNames: ['eslint', '@eslint/js'],
      groupName: 'eslint',
    },
    {
      // eslint-plugin-vue は vue-eslint-parser を peer に取り、片方だけ上げると npm が解決できないことがある。
      matchPackageNames: ['eslint-plugin-vue', 'vue-eslint-parser'],
      groupName: 'eslint-plugin-vue',
    },
  ],
}
